<Page x:Class="UpperComInspectionInstrument2022.Views.RealTimeMeasurementPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA">
 <Page.Resources>
  <Style TargetType="Button"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="16,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Page.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,18"><StackPanel><StackPanel Orientation="Horizontal"><Button Content="‹ 返回首页" Width="105" Height="34" Margin="0,0,18,0" Click="BackHomeButton_Click"/><TextBlock Text="实时测量" FontSize="28" FontWeight="Bold" Foreground="#172033" VerticalAlignment="Center"/></StackPanel><TextBlock Text="连接标准器并采集当前测量点数据，所有采集批次将自动保留。" Foreground="#687386" Margin="123,6,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="设备状态" Foreground="#687386" HorizontalAlignment="Right"/><TextBlock x:Name="PortTextBlock" Text="未连接" FontSize="16" FontWeight="SemiBold" Foreground="#B45309" HorizontalAlignment="Right"/></StackPanel></Grid>
  <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="采集配置" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,22,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="从站地址" VerticalAlignment="Center"/><TextBox x:Name="SlaveAddressTextBox" Text="1" Width="55" Margin="8,0,20,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="采集周期" VerticalAlignment="Center"/><TextBox x:Name="IntervalTextBox" Text="1000" Width="75" Margin="8,0,8,0"/><TextBlock Text="毫秒" Foreground="#687386" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Column="4" Text="数据按批次保存，建议周期不小于 200 ms" Foreground="#687386" VerticalAlignment="Center" Margin="20,0"/><StackPanel Grid.Column="5" Orientation="Horizontal"><Button x:Name="StartAcquisitionButton" Content="开始采集" Height="36" Margin="8,0,8,0" Click="StartAcquisitionButton_Click"/><Button x:Name="StopAcquisitionButton" Content="停止" Height="36" Background="#E5E7EB" Foreground="#374151" Click="StopAcquisitionButton_Click"/></StackPanel></Grid></Border>
  <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="采集批次" Foreground="#687386"/><TextBlock x:Name="AcquisitionCountTextBlock" Text="0" FontSize="25" FontWeight="Bold" Foreground="#172033" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="8,0"><StackPanel><TextBlock Text="当前状态" Foreground="#687386"/><TextBlock x:Name="StatusTextBlock" Text="等待采集" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="8,0"><StackPanel><TextBlock Text="设备类型" Foreground="#687386"/><TextBlock Text="50 路温度巡检仪" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="3" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="操作提示" Foreground="#687386"/><TextBlock Text="选择批次查看明细" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,8,0,0"/></StackPanel></Border></Grid>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Margin="0,0,0,10"><TextBlock Text="采集记录" FontSize="17" FontWeight="Bold" Foreground="#172033"/><TextBlock Text="选择一条记录查看右侧明细" Foreground="#687386" Margin="0,4,0,0"/></StackPanel><DataGrid Grid.Row="1" x:Name="SnapshotDataGrid" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}" SelectionChanged="SnapshotDataGrid_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="批次" Binding="{Binding Sequence}" Width="70"/><DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="90"/><DataGridTextColumn Header="有效" Binding="{Binding ValidChannelCount}" Width="60"/></DataGrid.Columns></DataGrid></Grid></Border><Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,10"><StackPanel><TextBlock Text="通道明细" FontSize="17" FontWeight="Bold" Foreground="#172033"/><TextBlock Text="当前选中批次的 50 路测量数据" Foreground="#687386" Margin="0,4,0,0"/></StackPanel><Button Content="清空记录" Width="100" Height="32" HorizontalAlignment="Right" Background="#FEE2E2" Foreground="#B91C1C" Click="ClearDataButton_Click"/></Grid><DataGrid Grid.Row="1" x:Name="ChannelDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="70"/><DataGridTextColumn Header="测量值" Binding="{Binding Value, StringFormat=F2}" Width="110"/><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="采集时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="150"/></DataGrid.Columns></DataGrid></Grid></Border></Grid>
 </Grid>
</Page>

