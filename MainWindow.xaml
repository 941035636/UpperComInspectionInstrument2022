

    
<!--下面为UI主入口-->
<Window x:Class="UpperComInspectionInstrument2022.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="工业设备校准系统"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#687386"/>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- 顶部标题栏 -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#1F2937">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- 软件名称 -->

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="25,0,0,0">

                    <TextBlock Text="工业设备校准系统"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  /  "
                               Foreground="#9CA3AF"
                               FontSize="20"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="标准器数据采集与校准"
                               Foreground="#D1D5DB"
                               FontSize="16"
                               VerticalAlignment="Center"/>

                </StackPanel>


                <!-- 当前时间/系统状态 -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,25,0">

                    <TextBlock Text="串口" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="PortComboBox" Width="85" Height="28" Margin="0,0,6,0"/>
                    <ComboBox x:Name="BaudRateComboBox" Width="85" Height="28" SelectedIndex="0" Margin="0,0,6,0">
                        <ComboBoxItem Content="115200"/>
                        <ComboBoxItem Content="9600"/>
                    </ComboBox>
                    <Button x:Name="OpenPortButton" Content="打开" Width="55" Height="28" Margin="0,0,12,0" Click="OpenPortButton_Click"/>

                    <Ellipse Width="10"
                             Height="10"
                             Fill="LimeGreen"
                             Margin="0,0,8,0"/>

                    <TextBlock x:Name="ConnectionStatusTextBlock"
                               Text="未连接"
                               Foreground="White"
                               FontSize="14"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- 主体区域 -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- 左侧菜单 -->

                <ColumnDefinition Width="220"/>

                <!-- 右侧内容 -->

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- 左侧导航 -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="#111827">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- 导航标题 -->

                    <StackPanel Grid.Row="0"
                                Margin="20,25,20,20">

                        <TextBlock Text="功能导航"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Calibration System"
                                   Foreground="#9CA3AF"
                                   FontSize="11"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- 导航按钮 -->

                    <StackPanel Grid.Row="1">


                        <!-- 首页 -->

                        <Button x:Name="HomeButton"
                                Content="首页"
                                Height="55"
                                Margin="10,5"
                                HorizontalContentAlignment="Left"
                                Padding="20,0"
                                FontSize="15"
                                Foreground="White"
                                Background="#374151"
                                BorderThickness="0"
                                Click="HomeButton_Click"/>


                        <!-- 实时测量 -->

                        <Button x:Name="RealTimeMeasurementButton"
                                Content="实时测量"
                                Height="55"
                                Margin="10,5"
                                HorizontalContentAlignment="Left"
                                Padding="20,0"
                                FontSize="15"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="RealTimeMeasurementButton_Click"/>


                        <!-- 校准任务 -->

                        <Button x:Name="CalibrationTaskButton"
                                Content="校准任务"
                                Height="55"
                                Margin="10,5"
                                HorizontalContentAlignment="Left"
                                Padding="20,0"
                                FontSize="15"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CalibrationTaskButton_Click"/>


                        <!-- 校准结果 -->

                        <Button x:Name="CalibrationResultButton"
                                Content="校准结果"
                                Height="55"
                                Margin="10,5"
                                HorizontalContentAlignment="Left"
                                Padding="20,0"
                                FontSize="15"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CalibrationResultButton_Click"/>


                        <!-- 历史记录 -->

                        <Button x:Name="HistoryButton"
                                Content="历史记录"
                                Height="55"
                                Margin="10,5"
                                HorizontalContentAlignment="Left"
                                Padding="20,0"
                                FontSize="15"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="HistoryButton_Click"/>


                        <!-- 系统设置 -->

                        <Button x:Name="SettingsButton"
                                Content="系统设置"
                                Height="55"
                                Margin="10,5"
                                HorizontalContentAlignment="Left"
                                Padding="20,0"
                                FontSize="15"
                                Foreground="White"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SettingsButton_Click"/>

                    </StackPanel>


                    <!-- 左下角版本 -->

                    <StackPanel Grid.Row="2"
                                Margin="20,10,20,20">

                        <TextBlock Text="工业校准平台"
                                   Foreground="#D1D5DB"
                                   FontSize="12"/>

                        <TextBlock Text="Version 1.0"
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- 右侧内容 -->
            <!-- ================================================= -->

            <Border Grid.Column="1"
                    Background="#F5F7FA">

                <!--
                    MainFrame 用于页面切换：

                    首页
                      ↓
                    实时测量
                      ↓
                    校准任务
                      ↓
                    校准结果
                -->

                <Frame x:Name="MainFrame"
                       NavigationUIVisibility="Hidden"
                       JournalOwnership="OwnsJournal"/>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- 底部状态栏 -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="#E5E7EB">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <TextBlock x:Name="BottomStatusTextBlock"
                           Grid.Column="0"
                           Text="状态：系统就绪"
                           VerticalAlignment="Center"
                           Margin="15,0"
                           Foreground="#374151"
                           FontSize="12"/>


                <TextBlock Grid.Column="1"
                           Text="Modbus RTU | RS232"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"
                           Foreground="#6B7280"
                           FontSize="12"/>

            </Grid>

        </Border>

    </Grid>

</Window>

