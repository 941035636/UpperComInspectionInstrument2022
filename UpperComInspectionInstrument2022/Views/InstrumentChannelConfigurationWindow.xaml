<Window x:Class="UpperComInspectionInstrument2022.Views.InstrumentChannelConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务测点与设备通道配置" Width="980" Height="780"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#EEF2F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" Padding="24,18" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="任务测点与设备通道配置" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Margin="0,6,0,0" Foreground="#64748B" TextWrapping="Wrap"
                           Text="为每个任务测点选择实际接线接口。保存时自动开启已绑定通道、关闭未绑定通道，并在设备读回确认后同步任务绑定。"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="20,14">
            <TabItem Header="温度测点与接口">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="190"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="本任务温度测点绑定" Padding="8">
                        <DataGrid x:Name="TemperatureMappingGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="逻辑测点" Binding="{Binding LogicalPointLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridComboBoxColumn x:Name="TemperaturePhysicalColumn" Header="巡检仪物理接口"
                                                        DisplayMemberPath="Label" SelectedValuePath="ChannelNumber"
                                                        SelectedValueBinding="{Binding PhysicalChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <TextBlock Grid.Row="1" Margin="4,8" Foreground="#64748B" TextWrapping="Wrap"
                               Text="下表用于核对设备当前使能状态和保存后的目标状态；传感器类型由巡检仪本机统一设置。"/>
                    <GroupBox Grid.Row="2" Header="设备温度接口状态" Padding="8">
                        <DataGrid x:Name="TemperatureGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" RowHeaderWidth="0" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="物理接口" Binding="{Binding ChannelLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="任务测点" Binding="{Binding BoundPointLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="当前设备" Binding="{Binding CurrentStateLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="保存后" Binding="{Binding DesiredStateLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="配置诊断" Binding="{Binding ConfigurationStatus}" IsReadOnly="True" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="HumidityTab" Header="湿度测点与接口">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="130"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="170"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="本任务湿度测点绑定" Padding="8">
                        <DataGrid x:Name="HumidityMappingGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="逻辑测点" Binding="{Binding LogicalPointLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridComboBoxColumn x:Name="HumidityPhysicalColumn" Header="巡检仪物理接口"
                                                        DisplayMemberPath="Label" SelectedValuePath="ChannelNumber"
                                                        SelectedValueBinding="{Binding PhysicalChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <TextBlock Grid.Row="1" Margin="4,8" Foreground="#64748B" TextWrapping="Wrap"
                               Text="湿度逻辑测点只绑定 H1～H9；未被当前任务使用的湿度接口将在保存时自动关闭。"/>
                    <GroupBox Grid.Row="2" Header="设备湿度接口状态" Padding="8">
                        <DataGrid x:Name="HumidityGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" RowHeaderWidth="0" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="湿度接口" Binding="{Binding ChannelLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="任务测点" Binding="{Binding BoundPointLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="当前设备" Binding="{Binding CurrentStateLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="保存后" Binding="{Binding DesiredStateLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="配置诊断" Binding="{Binding ConfigurationStatus}" IsReadOnly="True" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#D8E0EA" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="BindingSummaryTextBlock" FontWeight="SemiBold" Foreground="#1D4ED8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusTextBlock" Margin="0,4,12,0" Text="尚未读取设备配置" FontWeight="SemiBold" Foreground="#B45309" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ByteOrderTextBlock" Margin="0,2,12,0" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="FrameTextBlock" Margin="0,3,12,0" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="ReadButton" Width="130" Content="读取设备配置" Click="ReadButton_Click" Padding="14,8"/>
                    <Button x:Name="SaveButton" Width="170" Margin="10,0,0,0" Content="保存绑定并应用设备" Click="SaveButton_Click"
                            IsEnabled="False" Padding="14,8" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="CloseButton" Width="80" Margin="10,0,0,0" Content="关闭" IsCancel="True" Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
