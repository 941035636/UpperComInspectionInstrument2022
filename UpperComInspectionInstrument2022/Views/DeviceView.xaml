<Page x:Class="UpperComInspectionInstrument2022.Views.DeviceView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="系统设置">
    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style TargetType="DatePicker" x:Key="FieldDatePicker">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </Page.Resources>
    <Grid Background="#EEF2F6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" Padding="28,20" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="系统设置" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="维护长期有效的实验室与标准器资料。" Margin="0,7,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,18,28,24">
                <Border Padding="20" Background="White" CornerRadius="8" BorderBrush="#D8E0EA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="实验室与标准器身份" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937"/>
                        <TextBlock Text="保存任务时会生成一份只读快照，后续修改这里不会改变已建立任务。" Margin="0,7,0,0" Foreground="#64748B"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/></Grid.ColumnDefinitions>
                            <TextBlock Text="实验室名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LaboratoryNameTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" ToolTip="用于校准报告中的实验室名称；可稍后补充。"/>
                            <TextBlock Grid.Column="2" Text="实验室地址" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="LaboratoryAddressTextBox" Grid.Column="3" Style="{StaticResource FieldBox}" ToolTip="用于校准报告中的实验室地址；可稍后补充。"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/></Grid.ColumnDefinitions>
                            <TextBlock Text="标准器名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StandardNameTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" ToolTip="可稍后补充；正式校准前必须完善。"/>
                            <TextBlock Grid.Column="2" Text="证书编号" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="CertificateNumberTextBox" Grid.Column="3" Style="{StaticResource FieldBox}" ToolTip="可稍后补充；正式校准前必须完善。"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/></Grid.ColumnDefinitions>
                            <TextBlock Text="有效期至" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="ValidityDatePicker" Grid.Column="1" Style="{StaticResource FieldDatePicker}"/>
                            <TextBlock Grid.Column="2" Text="型号规格" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="ModelTextBox" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/></Grid.ColumnDefinitions>
                            <TextBlock Text="出厂编号" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SerialNumberTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Column="2" Text="校准机构" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="OrganizationTextBox" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="820"/></Grid.ColumnDefinitions>
                            <TextBlock Text="机构地址" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OrganizationAddressTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="20" Background="White" CornerRadius="8" BorderBrush="#D8E0EA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="测量能力与溯源参数" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/></Grid.ColumnDefinitions>
                            <TextBlock Text="温度量程" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TemperatureRangeTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                            <TextBlock x:Name="HumidityRangeLabel" Grid.Column="2" Text="湿度量程" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="HumidityRangeTextBox" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/></Grid.ColumnDefinitions>
                            <TextBlock Text="温度分辨力 (℃)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TemperatureResolutionTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                            <TextBlock x:Name="HumidityResolutionLabel" Grid.Column="2" Text="湿度分辨力 (%RH)" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="HumidityResolutionTextBox" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                        </Grid>
                        <Grid x:Name="Jjf1101AccuracyPanel" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*" MaxWidth="820"/></Grid.ColumnDefinitions>
                            <TextBlock Text="规范准确度/MPE" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AccuracySpecificationTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" IsReadOnly="True" Background="#F8FAFC"/>
                        </Grid>
                        <Grid x:Name="Jjf1376InstrumentPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*" MaxWidth="380"/></Grid.ColumnDefinitions>
                            <TextBlock Text="测温仪器级别" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MeasuringInstrumentClassTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" IsReadOnly="True" Background="#F8FAFC"/>
                            <TextBlock Grid.Column="2" Text="热电偶等级" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="ThermocoupleGradeTextBox" Grid.Column="3" Style="{StaticResource FieldBox}" IsReadOnly="True" Background="#F8FAFC"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="20" Background="White" CornerRadius="8" BorderBrush="#D8E0EA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="证书不确定度与通道修正" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937"/>
                        <TextBlock Text="这里填写证书给出的扩展不确定度 U 和包含因子 k。通道修正格式示例：1:0.02,2:-0.01；留空表示数据已修正或暂未录入。" Margin="0,7,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="CertificateParameterGapColumn" Width="18"/><ColumnDefinition x:Name="HumidityCertificateColumn" Width="*"/></Grid.ColumnDefinitions>
                            <Border Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="温度证书参数" Foreground="#334155" FontWeight="SemiBold"/>
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*" MaxWidth="150"/></Grid.ColumnDefinitions><TextBlock Text="扩展不确定度 U (℃)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TemperatureUncertaintyTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/></Grid>
                                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*" MaxWidth="150"/></Grid.ColumnDefinitions><TextBlock Text="包含因子 k" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TemperatureCoverageTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/></Grid>
                                    <Grid x:Name="TemperatureStabilityChangeRow" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*" MaxWidth="150"/></Grid.ColumnDefinitions><TextBlock Text="修正值最大变化 (℃)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TemperatureStabilityChangeTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/></Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="HumidityCertificatePanel" Grid.Column="2" Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="湿度证书参数" Foreground="#334155" FontWeight="SemiBold"/>
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*" MaxWidth="150"/></Grid.ColumnDefinitions><TextBlock Text="扩展不确定度 U (%RH)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HumidityUncertaintyTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/></Grid>
                                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*" MaxWidth="150"/></Grid.ColumnDefinitions><TextBlock Text="包含因子 k" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HumidityCoverageTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/></Grid>
                                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*" MaxWidth="150"/></Grid.ColumnDefinitions><TextBlock Text="修正值最大变化 (%RH)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HumidityStabilityChangeTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*" MaxWidth="820"/></Grid.ColumnDefinitions>
                            <TextBlock Text="温度通道修正" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TemperatureCorrectionsTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                        </Grid>
                        <Grid x:Name="HumidityCorrectionsGrid" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*" MaxWidth="820"/></Grid.ColumnDefinitions>
                            <TextBlock Text="湿度通道修正" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HumidityCorrectionsTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#D8E0EA" BorderThickness="0,1,0,0" Padding="28,12">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock" Text="设置尚未保存" Foreground="#B45309" FontWeight="SemiBold"/>
                    <TextBlock Text="资料可以先留空；保存任务不会丢失任务配置，开始正式校准前系统会提示补齐必需的标准器信息。" Foreground="#64748B" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="SaveSettingsButton" DockPanel.Dock="Right" Width="220" Content="保存系统资料" Click="SaveButton_Click" Padding="24,10" Background="#2563EB" Foreground="White" BorderThickness="0"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
