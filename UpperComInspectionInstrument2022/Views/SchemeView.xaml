<Page x:Class="UpperComInspectionInstrument2022.Views.SchemeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="任务配置">
    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel"><Setter Property="Foreground" Value="#475569"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox" x:Key="FieldCombo"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="BorderBrush" Value="#CBD5E1"/></Style>
        <Style TargetType="TextBlock" x:Key="RuleLabel"><Setter Property="Foreground" Value="#1D4ED8"/><Setter Property="FontSize" Value="12"/></Style>
    </Page.Resources>

    <Grid Background="#EEF2F6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" Padding="28,20" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="任务配置" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="步骤 1/3 · 选择规范和当前校准工况，自动生成布点、稳定和正式采样计划" Margin="0,7,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,18,28,24">
                <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#D8E0EA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="1 校准依据" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="校准规范 *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="StandardComboBox" Grid.Column="1" Style="{StaticResource FieldCombo}" SelectionChanged="StandardComboBox_SelectionChanged"><ComboBoxItem Content="JJF 1101-2019 环境试验设备温度湿度参数校准规范"/><ComboBoxItem Content="JJF 1376-2012 箱式电阻炉校准规范"/></ComboBox>
                            <TextBlock Grid.Column="2" Text="校准项目 *" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/>
                            <ComboBox x:Name="CalibrationTypeComboBox" Grid.Column="3" Style="{StaticResource FieldCombo}" SelectionChanged="CalibrationTypeComboBox_SelectionChanged"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="VolumeLabel" Text="设备容积 *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="VolumeComboBox" Grid.Column="1" Style="{StaticResource FieldCombo}" SelectionChanged="VolumeComboBox_SelectionChanged"/>
                            <TextBlock Grid.Column="2" Text="校准点方案 *" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/>
                            <ComboBox x:Name="PointSelectionComboBox" Grid.Column="3" Style="{StaticResource FieldCombo}" SelectionChanged="PointSelectionComboBox_SelectionChanged"/>
                        </Grid>

                        <Border Margin="0,16,0,0" Padding="14" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="适用范围与环境" Style="{StaticResource RuleLabel}"/><TextBlock x:Name="RuleScopeTextBlock" Margin="0,5,18,0" Foreground="#1E3A8A" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="规范布点与采样" Style="{StaticResource RuleLabel}"/><TextBlock x:Name="RulePlanTextBlock" Margin="0,5,18,0" Foreground="#1E3A8A" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="稳定条件与输出项目" Style="{StaticResource RuleLabel}"/><TextBlock x:Name="RuleStabilityTextBlock" Margin="0,5,0,0" Foreground="#1E3A8A" TextWrapping="Wrap"/></StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Padding="12" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="引用标准器" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="StandardReferenceTextBlock" Text="未配置标准器资料" Foreground="#334155" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="量程 / 分辨力 / 证书不确定度" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="StandardCapabilityTextBlock" Foreground="#334155" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                                <Button Grid.Column="2" Content="维护标准器资料" Click="OpenSystemSettingsButton_Click" Padding="14,7" Background="White" Foreground="#1D4ED8" BorderBrush="#93C5FD"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Background="White" CornerRadius="8" Padding="20" BorderBrush="#D8E0EA" BorderThickness="1">
                    <Expander x:Name="OptionalArchiveExpander" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Text="2 被校设备与委托信息（可选）" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="不影响连接、实时观察和正式采样；需要归档或出具报告时再展开补充。" Margin="0,6,0,0" Foreground="#64748B"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,14,0,0">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="委托单位（可选）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CustomerNameTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Column="2" Text="校准地点（可选）" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="CalibrationLocationTextBox" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="设备名称（可选）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EquipmentNameTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Column="2" Text="制造厂（可选）" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="ManufacturerTextBox" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="型号规格（可选）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ModelSpecificationTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Column="2" Text="出厂编号（可选）" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="EquipmentSerialNumberTextBox" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="校准日期（可选）" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="CalibrationDatePicker" Grid.Column="1" Margin="8,0,0,0" Padding="5"/>
                        </Grid>
                        <Expander Header="报告补充信息（可选）" Margin="0,14,0,0" Foreground="#475569">
                            <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="委托单位地址（可选）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CustomerAddressTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                    <TextBlock Grid.Column="2" Text="校准员/核验员（可选）" Style="{StaticResource FieldLabel}" Margin="10,0,0,0"/><Grid Grid.Column="3" Margin="8,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="CalibratorTextBox" Padding="8,6" Margin="0,0,4,0"/><TextBox x:Name="VerifierTextBox" Grid.Column="1" Padding="8,6" Margin="4,0,0,0"/></Grid>
                                </Grid>
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Margin="0,14,0,0" Background="White" CornerRadius="8" Padding="20" BorderBrush="#D8E0EA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="3 校准点与布点" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="不可更改的参数项由规范和设备容积自动生成；可改项是本次任务实值，必须按设备设定、实际接线和铭牌/说明书填写。" Margin="0,6,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="设定温度 (℃) *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SetTemperatureTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" TextChanged="LinkageInput_TextChanged" ToolTip="填写被校设备本次实际设定值；规范只校验适用范围，不提供固定设定值。"/>
                            <TextBlock Grid.Column="2" x:Name="SetHumidityLabel" Text="设定湿度 (%RH) *" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="SetHumidityTextBox" Grid.Column="3" Style="{StaticResource FieldBox}" TextChanged="LinkageInput_TextChanged" ToolTip="填写被校设备本次实际设定值，不能由软件预填。"/>
                            <TextBlock Grid.Column="4" Text="传感器类型 *" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><ComboBox x:Name="SensorTypeComboBox" Grid.Column="5" Style="{StaticResource FieldCombo}" ToolTip="按本次巡检仪实际接入的温度传感器选择；软件不再默认选择 Pt100。"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="MeasurementRangeLabel" Text="使用/测量范围（可选）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MeasurementRangeTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" ToolTip="通常可留空；选择范围下限/上限/中间点方案时才需填写。格式示例：-40～150 ℃；20～95 %RH。"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="110"/><ColumnDefinition Width="70"/><ColumnDefinition Width="110"/><ColumnDefinition Width="70"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="WorkZoneDimensionLabel" Text="工作区尺寸 (mm)（可选）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WorkZoneLengthTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" ToolTip="长度；JJF 1376 和 JJF 1101 极端容积调整点数时必填。"/>
                            <TextBlock Grid.Column="2" Text="宽" Style="{StaticResource FieldLabel}" Margin="20,0,0,0"/><TextBox x:Name="WorkZoneWidthTextBox" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Column="4" Text="高" Style="{StaticResource FieldLabel}" Margin="20,0,0,0"/><TextBox x:Name="WorkZoneHeightTextBox" Grid.Column="5" Style="{StaticResource FieldBox}"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="温度空间测点数 *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TemperaturePointCountTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" TextChanged="LinkageInput_TextChanged" ToolTip="按所选规范和容积自动生成；选择自定义布点后可修改。"/>
                            <TextBlock Grid.Column="2" x:Name="HumidityPointCountLabel" Text="湿度空间测点数 *" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/>
                            <TextBox x:Name="HumidityPointCountTextBox" Grid.Column="3" Style="{StaticResource FieldBox}" TextChanged="LinkageInput_TextChanged" ToolTip="按所选规范和容积自动生成；选择自定义布点后可修改。"/>
                            <TextBlock Grid.Column="4" Text="温度中心点 *" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/>
                            <TextBox x:Name="TemperatureCenterPointTextBox" Grid.Column="5" Style="{StaticResource FieldBox}" TextChanged="LinkageInput_TextChanged" ToolTip="按规范默认空间布点自动生成；选择自定义布点后可修改。"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="HumidityCenterPointLabel" Text="湿度 O 对应通道 *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HumidityCenterPointTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" TextChanged="LinkageInput_TextChanged" ToolTip="规范规定中心位置 O，但不规定巡检仪接线通道；请按实际接线确认。"/>
                            <TextBlock Grid.Column="2" Text="布点方式" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/>
                            <Grid Grid.Column="3" Margin="8,0,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="PointLayoutModeComboBox" Margin="0" Padding="7,5" BorderBrush="#CBD5E1" SelectionChanged="PointLayoutModeComboBox_SelectionChanged"/>
                                <Button x:Name="ViewLayoutFigureButton" Grid.Column="1" Content="查看图 1 / 图 2" Click="ViewLayoutFigureButton_Click" Margin="10,0,0,0" Padding="14,6" Background="White" Foreground="#1D4ED8" BorderBrush="#93C5FD" Visibility="Collapsed" ToolTip="查看 JJF 1376-2012 图 1、图 2 的测温区与测温点位置示意图"/>
                            </Grid>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="布点说明" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PointLayoutDescriptionTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52"/>
                        </Grid>
                        <Border Margin="0,12,0,0" Padding="12" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="依据 - 当前校准工况 - 空间布点联动" Foreground="#166534" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TaskLinkageSummaryTextBlock" Margin="0,5,0,0" Foreground="#166534" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="160"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <TextBlock Text="被校温度分辨力 *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DutTemperatureResolutionTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" ToolTip="填写被校设备温度显示的最小变化量，用于设备档案和报告。附录不确定度计算使用标准器分辨力，二者不要混淆。"/>
                            <TextBlock Grid.Column="2" x:Name="DutHumidityResolutionLabel" Text="被校湿度分辨力 *" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="DutHumidityResolutionTextBox" Grid.Column="3" Style="{StaticResource FieldBox}" ToolTip="填写被校设备湿度显示的最小变化量，用于设备档案和报告；不能默认写成 0 或 1。"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Background="White" CornerRadius="8" Padding="20" BorderBrush="#D8E0EA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="4 现场条件与执行计划" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <TextBlock Text="环境温度 (℃) *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AmbientTemperatureTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Column="2" Text="环境湿度 (%RH) *" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="AmbientHumidityTextBox" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                            <TextBlock x:Name="AmbientPressureLabel" Grid.Column="4" Text="环境气压 (kPa) *" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="AmbientPressureTextBox" Grid.Column="5" Style="{StaticResource FieldBox}"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="190"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="负载状态" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="LoadConditionComboBox" Grid.Column="1" Style="{StaticResource FieldCombo}" SelectionChanged="LoadConditionComboBox_SelectionChanged"><ComboBoxItem Content="空载（规范默认）"/><ComboBoxItem Content="负载"/></ComboBox>
                            <TextBlock Grid.Column="2" Text="负载说明" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="LoadDescriptionTextBox" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="正式样本数 *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PlannedCountTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Column="2" Text="正式采样间隔 (s) *" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><TextBox x:Name="SamplingIntervalTextBox" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Column="4" Text="稳定依据" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><ComboBox x:Name="StabilityBasisComboBox" Grid.Column="5" Style="{StaticResource FieldCombo}" SelectionChanged="StabilityBasisComboBox_SelectionChanged"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StableWaitLabel" Text="稳定等待 (min)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StableWaitTextBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                            <TextBlock x:Name="AppearanceCheckLabel" Grid.Column="2" Text="外观/运行检查" Style="{StaticResource FieldLabel}" Margin="28,0,0,0"/><ComboBox x:Name="AppearanceCheckComboBox" Grid.Column="3" Style="{StaticResource FieldCombo}"><ComboBoxItem Content="待检查"/><ComboBoxItem Content="符合"/><ComboBoxItem Content="不符合"/></ComboBox>
                        </Grid>
                        <CheckBox x:Name="EnvironmentConfirmedCheckBox" Margin="0,16,0,0" Content="已确认现场无规范禁止的强烈振动、腐蚀性气体、强气流或其他冷热源等干扰" Foreground="#334155"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="偏离/自定义说明" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DeviationDescriptionTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#D8E0EA" BorderThickness="0,1,0,0" Padding="28,12">
            <DockPanel>
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TaskStatusTextBlock" Text="任务尚未保存" Foreground="#B45309" FontWeight="SemiBold"/><TextBlock Text="保存后进入校准工作台；实时观察数据稳定后直接开始正式采样。" Foreground="#64748B" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                <Button DockPanel.Dock="Right" Content="保存并进入校准工作台" Click="StartCalibrationButton_Click" Padding="24,10" Background="#2563EB" Foreground="White" BorderThickness="0"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
