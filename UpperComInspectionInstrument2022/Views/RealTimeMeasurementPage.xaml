<Page x:Class="UpperComInspectionInstrument2022.Views.RealTimeMeasurementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="校准工作台">
    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="CaptionText">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="FieldCombo">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E8EEF5"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="← 任务配置" Width="100" Height="32" Click="BackHomeButton_Click" Style="{StaticResource SecondaryButton}"/>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="校准工作台" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="步骤 2/3 · 实时测量、稳定观察与正式校准" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionStatusEllipse" Width="10" Height="10" Fill="#F59E0B" Margin="0,0,7,0"/>
                    <TextBlock x:Name="ConnectionStatusTextBlock" Text="未连接" Foreground="#92400E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,12,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="372"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition Height="1.15*"/><RowDefinition Height="1.55*"/></Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Background="#FFFFFF" CornerRadius="7" Padding="18,13" Margin="0,0,12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="当前测量" Style="{StaticResource CaptionText}"/><TextBlock x:Name="LiveValueSummaryTextBlock" Text="等待设备数据" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,7,12,0" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="趋势预检" Style="{StaticResource CaptionText}"/><TextBlock x:Name="StabilityTextBlock" Text="未开始" FontSize="12" FontWeight="Bold" Foreground="#B45309" Margin="0,7,12,0" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="中心点" Style="{StaticResource CaptionText}"/><TextBlock x:Name="CenterSummaryTextBlock" Text="点 1：- / -" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,7,12,0" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="数据质量" Style="{StaticResource CaptionText}"/><TextBlock x:Name="QualitySummaryTextBlock" Text="任务通道 0/0" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,7,10,0" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="最新采集" Style="{StaticResource CaptionText}"/><TextBlock x:Name="CurrentTimeTextBlock" Text="-" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="0" Grid.Row="1" Background="#FFFFFF" CornerRadius="7" Padding="16,13" Margin="0,0,12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="实时趋势" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/><TextBlock Text="（最近 60 组）" Style="{StaticResource CaptionText}" Margin="8,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Rectangle Width="18" Height="3" Fill="#2563EB" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="温度平均" Foreground="#475569" Margin="0,0,14,0"/>
                                <Rectangle Width="18" Height="3" Fill="#059669" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="湿度平均" Foreground="#475569"/>
                            </StackPanel>
                            <TextBlock x:Name="ChartScaleTextBlock" Text="等待有效任务通道" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#FBFCFE" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Canvas x:Name="MeasurementChartCanvas" SizeChanged="MeasurementChartCanvas_SizeChanged" Background="#FBFCFE"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="0" Grid.Row="2" Background="#FFFFFF" CornerRadius="7" Padding="16,13" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="测点数据矩阵" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/><TextBlock Text="（每一行是一组完整采集）" Style="{StaticResource CaptionText}" Margin="8,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="采集序号" Foreground="#64748B"/><TextBlock x:Name="CurrentSequenceTextBlock" Text="-" FontWeight="Bold" Margin="6,0,0,0"/></StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="MeasurementMatrixDataGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False" SelectionMode="Single" GridLinesVisibility="All" RowHeight="31" HeadersVisibility="All" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Background="#FFFFFF" CornerRadius="7" Padding="14,14" BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="工作台控制" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>

                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><Ellipse x:Name="DeviceCardStatusEllipse" Width="9" Height="9" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock x:Name="DeviceCardStatusTextBlock" Text="设备未连接" FontWeight="Bold" Foreground="#334155"/></StackPanel>
                                <TextBlock x:Name="PortTextBlock" Text="串口：未选择" Style="{StaticResource CaptionText}" Margin="15,6,0,0"/>
                                <TextBlock x:Name="BaudRateTextBlock" Text="波特率：未设置" Style="{StaticResource CaptionText}" Margin="15,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="串口" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/><ComboBox x:Name="PortComboBox" Grid.Column="1" Style="{StaticResource FieldCombo}" Margin="0"/>
                            <TextBlock Grid.Column="2" Text="波特率" Style="{StaticResource FieldLabel}" Margin="12,0,6,0"/><ComboBox x:Name="BaudRateComboBox" Grid.Column="3" Style="{StaticResource FieldCombo}" Margin="0"><ComboBoxItem Content="115200"/><ComboBoxItem Content="9600"/></ComboBox>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="从站" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/><TextBox x:Name="SlaveAddressTextBox" Grid.Column="1" Text="1" Style="{StaticResource FieldBox}" Margin="0"/>
                            <TextBlock Grid.Column="2" Text="周期(ms)" Style="{StaticResource FieldLabel}" Margin="12,0,6,0"/><TextBox x:Name="IntervalTextBox" Grid.Column="3" Text="2000" Style="{StaticResource FieldBox}" Margin="0"/>
                        </Grid>
                        <Button Content="刷新可用串口" Click="RefreshPortsButton_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,9,0,0"/>

                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox x:Name="SaveRealtimeRecordCheckBox" Content="自动保存实时记录" IsChecked="True" FontWeight="SemiBold" Foreground="#166534"/>
                                <DockPanel Margin="0,7,0,0">
                                    <!-- <Button x:Name="OpenRealtimeRecordButton" DockPanel.Dock="Right" Content="打开目录" Click="OpenRealtimeRecordButton_Click" Style="{StaticResource SecondaryButton}" Padding="9,4" Margin="8,0,0,0"/>
                                   <TextBlock x:Name="RealtimeRecordStatusTextBlock" Text="开始实时测量后，每次完整响应会立即写入本地" Foreground="#15803D" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                -->
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="执行控制" FontWeight="Bold" Foreground="#334155" Margin="0,14,0,7"/>
                        <Button x:Name="ConnectDeviceButton" Content="连接巡检仪" Height="36" Click="ConnectDeviceButton_Click" Style="{StaticResource SecondaryButton}"/>
                        <Button x:Name="StartAcquisitionButton" Content="开始实时测量" Height="40" Margin="0,8,0,0" IsEnabled="False" Click="StartAcquisitionButton_Click" Background="#2563EB" Foreground="Black" BorderThickness="0" FontWeight="SemiBold"/>
                        <Button x:Name="StartCalibrationButton" Content="启动校准采样" Height="44" Margin="0,8,0,0" IsEnabled="False" Click="StartCalibrationButton_Click" Background="#059669" Foreground="Black" BorderThickness="0" FontWeight="Bold"/>
                        <Button x:Name="ViewResultButton" Content="查看结果与报告" Height="38" Margin="0,8,0,0" IsEnabled="False" Click="ViewResultButton_Click" Background="#0F172A" Foreground="Black" BorderThickness="0" FontWeight="SemiBold"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="StopAcquisitionButton" Content="暂停" Height="34" IsEnabled="False" Click="StopAcquisitionButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/><Button x:Name="ClearDataButton" Grid.Column="1" Content="清空数据" Height="34" Click="ClearDataButton_Click" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/></Grid>

                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="当前任务" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock x:Name="TaskSummaryTextBlock" Text="尚未配置任务，任务参数可在下方填写。" TextWrapping="Wrap" Foreground="#475569" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="FormalReadinessPanel" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="正式校准条件" FontWeight="Bold" Foreground="#92400E"/>

                                <CheckBox x:Name="SetPointReachedCheckBox" Content="设备已达到设定值（从此刻开始稳定计时）" Margin="0,9,0,0" Checked="StabilityConfirmation_Changed" Unchecked="StabilityConfirmation_Changed"/>
                                <CheckBox x:Name="ConfirmStableCheckBox" Content="已依据说明书/设备状态确认稳定" Margin="0,7,0,0" Checked="StabilityConfirmation_Changed" Unchecked="StabilityConfirmation_Changed"/>
                                <TextBlock x:Name="FormalReadinessTextBlock" Text="等待有效数据和稳定确认" TextWrapping="Wrap" Foreground="#B45309" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <Button x:Name="RefreshStandardReferenceButton" Content="同步/维护标准器资料" Visibility="Collapsed" Click="RefreshStandardReferenceButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"/>
                                <Separator Margin="0,10,0,8"/>
                                <TextBlock Text="被校设备示值" FontWeight="SemiBold" Foreground="#334155" TextWrapping="Wrap"/>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="温度" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/><TextBox x:Name="DutDisplayTemperatureTextBox" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0"/>
                                    <TextBlock x:Name="DutDisplayHumidityLabel" Grid.Column="2" Text="湿度" Style="{StaticResource FieldLabel}" Margin="12,0,6,0"/><TextBox x:Name="DutDisplayHumidityTextBox" Grid.Column="3" Style="{StaticResource FieldBox}" Margin="0"/>
                                </Grid>
                                <TextBlock x:Name="FormalSampleProgressTextBlock" Text="正式样本 0 / 0" Foreground="#475569" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="TaskParameterPanel" Margin="0,10,0,0">
                            <TextBlock Text="任务参数" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,7"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="校准类型" Style="{StaticResource FieldLabel}" Margin="0,4,6,4"/><ComboBox x:Name="CalibrationTypeComboBox" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FieldCombo}" Margin="0,0,0,0" SelectionChanged="CalibrationTypeComboBox_SelectionChanged"><ComboBoxItem Content="温度"/><ComboBoxItem Content="湿度"/><ComboBoxItem Content="温度+湿度"/><ComboBoxItem Content="温湿度"/></ComboBox>
                                <TextBlock Grid.Row="1" x:Name="TemperaturePointCountLabel" Text="温度点数" Style="{StaticResource FieldLabel}" Margin="0,8,6,4"/><ComboBox x:Name="TemperaturePointCountComboBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldCombo}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="HumidityPointCountLabel" Text="湿度点数" Style="{StaticResource FieldLabel}" Margin="12,8,6,4"/><ComboBox x:Name="HumidityPointCountComboBox" Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldCombo}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" x:Name="SensorTypeLabel" Text="传感器" Style="{StaticResource FieldLabel}" Margin="0,8,6,4"/><ComboBox x:Name="SensorTypeComboBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldCombo}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="计划次数" Style="{StaticResource FieldLabel}" Margin="12,8,6,4"/><ComboBox x:Name="CalibrationCountComboBox" Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldCombo}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="3" Text="中心点" Style="{StaticResource FieldLabel}" Margin="0,8,6,4"/><ComboBox x:Name="CenterPointComboBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldCombo}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="稳定等待(s)" Style="{StaticResource FieldLabel}" Margin="12,8,6,4"/><TextBox x:Name="CenterIntervalTextBox" Grid.Row="3" Grid.Column="3" Text="60" Style="{StaticResource FieldBox}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="4" Text="校准间隔(s)" Style="{StaticResource FieldLabel}" Margin="0,8,6,4"/><TextBox x:Name="CalibrationIntervalTextBox" Grid.Row="4" Grid.Column="1" Text="60" Style="{StaticResource FieldBox}" Margin="0,4,0,0"/>
                            </Grid>
                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CenterTemperatureLabel" Text="中心温度" Style="{StaticResource CaptionText}"/><TextBlock x:Name="CenterTemperatureTextBlock" Text="-" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="CenterHumidityLabel" Text="中心湿度" Style="{StaticResource CaptionText}"/><TextBlock x:Name="CenterHumidityTextBlock" Text="-" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid>
                        </StackPanel>

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="10" Margin="0,14,0,0"><TextBlock Text="实时刷新只用于观察趋势；正式样本按任务中的 2 min/3 min 间隔单独留存。软件趋势阈值不是规范判据。" TextWrapping="Wrap" Foreground="#1D4ED8" FontSize="12"/></Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D8E0EA" BorderThickness="0,1,0,0" Padding="16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="状态：" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusTextBlock" Text="等待连接" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="通讯有效不等于校准合格，最终判定在校准结果中完成" Foreground="#64748B" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
