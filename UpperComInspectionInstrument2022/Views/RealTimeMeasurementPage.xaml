<Page x:Class="UpperComInspectionInstrument2022.Views.RealTimeMeasurementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="实时测量">

    <Grid Background="#F5F7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="280"/>
        </Grid.RowDefinitions>


        <!-- ==================== 顶部标题 ==================== -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1">

            <Grid>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0">

                    <Button Content="← 首页"
                            Width="90"
                            Height="34"
                            Margin="0,0,20,0"
                            Click="BackHomeButton_Click"/>

                    <TextBlock Text="实时测量"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ==================== 设备状态 ==================== -->

        <Border Grid.Row="1"
                Background="White"
                Margin="10,10,10,5"
                Padding="15">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="巡检仪："
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="标准器"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>


                <TextBlock Grid.Column="2"
                           Text="串口："
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           x:Name="PortTextBlock"
                           Text="COM7"
                           VerticalAlignment="Center"/>


                <TextBlock Grid.Column="4"
                           Text="波特率："
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="5"
                           Text="115200"
                           VerticalAlignment="Center"/>


                <StackPanel Grid.Column="7"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Ellipse Width="10"
                             Height="10"
                             Fill="LimeGreen"
                             Margin="0,0,6,0"/>

                    <TextBlock Text="设备已连接"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ==================== 操作按钮 ==================== -->

        <Border Grid.Row="2"
                Background="White"
                Margin="10,5"
                Padding="15">

            <StackPanel Orientation="Horizontal">

                <Button x:Name="StartAcquisitionButton"
                        Content="开始实时采集"
                        Width="130"
                        Height="38"
                        Margin="0,0,10,0"
                        Click="StartAcquisitionButton_Click"/>

                <Button x:Name="StopAcquisitionButton"
                        Content="停止采集"
                        Width="100"
                        Height="38"
                        Margin="0,0,10,0"
                        Click="StopAcquisitionButton_Click"/>

                <Button x:Name="ClearDataButton"
                        Content="清空记录"
                        Width="100"
                        Height="38"
                        Margin="0,0,30,0"
                        Click="ClearDataButton_Click"/>

                <Button x:Name="StartCalibrationButton"
                        Content="开始校准"
                        Width="120"
                        Height="38"
                        Click="StartCalibrationButton_Click"/>

            </StackPanel>

        </Border>


        <!-- ==================== 采集记录 ==================== -->

        <Border Grid.Row="3"
                Background="White"
                Margin="10,5"
                Padding="15">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <Grid Grid.Row="0"
                      Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Text="采集记录"
                               FontSize="18"
                               FontWeight="Bold"/>


                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <TextBlock Text="采集次数："
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="AcquisitionCountTextBlock"
                                   Text="0"
                                   FontWeight="Bold"
                                   Margin="5,0,20,0"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="状态："
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="StatusTextBlock"
                                   Text="等待采集"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Grid>


                <DataGrid Grid.Row="1"
                          x:Name="SnapshotDataGrid"
                          ItemsSource="{Binding Snapshots}"
                          SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="采集序号"
                                            Binding="{Binding Sequence}"
                                            Width="100"/>

                        <DataGridTextColumn Header="采集时间"
                                            Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss.fff}"
                                            Width="220"/>

                        <DataGridTextColumn Header="有效通道"
                                            Binding="{Binding ValidChannelCount}"
                                            Width="120"/>

                        <DataGridTextColumn Header="异常通道"
                                            Binding="{Binding InvalidChannelCount}"
                                            Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>


        <!-- ==================== 当前采集详细数据 ==================== -->

        <Border Grid.Row="4"
                Background="White"
                Margin="10,5,10,10"
                Padding="15">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                           Text="当前采集详细数据"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>


                <DataGrid Grid.Row="1"
                          x:Name="ChannelDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="测点"
                                            Binding="{Binding Channel}"
                                            Width="100"/>

                        <DataGridTextColumn Header="测量值"
                                            Binding="{Binding Value, StringFormat=F2}"
                                            Width="150"/>

                        <DataGridTextColumn Header="单位"
                                            Binding="{Binding Unit}"
                                            Width="80"/>

                        <DataGridTextColumn Header="状态"
                                            Binding="{Binding Status}"
                                            Width="100"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Page>