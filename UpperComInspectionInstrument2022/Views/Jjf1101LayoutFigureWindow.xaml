<Window x:Class="UpperComInspectionInstrument2022.Views.Jjf1101LayoutFigureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JJF 1101-2019 温湿度布点图"
        Width="1180"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#172033" Padding="22,16">
            <StackPanel>
                <TextBlock Text="JJF 1101-2019 环境试验设备温湿度布点图" Foreground="White" FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="数字表示温度测点，字母表示湿度测点；O 点位于工作空间中层几何中心。" Foreground="#CBD5E1" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="FigureTabControl" Grid.Row="1" Margin="18" Background="White" BorderBrush="#CBD5E1">
            <TabItem Header="图 1 · 容积 ≤ 2 m³">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White">
                    <Border Padding="18">
                        <Image x:Name="Figure1Image" Source="/UpperComInspectionInstrument2022;component/Resources/Standards/JJF1101-Figure1.png" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="图 2 · 容积 > 2 m³">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White">
                    <Border Padding="18">
                        <Image x:Name="Figure2Image" Source="/UpperComInspectionInstrument2022;component/Resources/Standards/JJF1101-Figure2.png" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <TextBlock Text="图示依据 JJF 1101-2019 第 7.2.2、7.2.3 条；各点距内壁通常为对应边长的 1/10，遇风道时可调整但不应超过 500 mm。" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,120,0"/>
                <Button Content="关闭" HorizontalAlignment="Right" Width="96" Padding="12,7" Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
