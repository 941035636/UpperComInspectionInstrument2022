<Window x:Class="UpperComInspectionInstrument2022.Views.ChannelMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="测点与巡检仪通道绑定" Width="760" Height="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#EEF2F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="White" Padding="24,18" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="测点与物理通道绑定" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Margin="0,6,0,0" Foreground="#64748B" TextWrapping="Wrap"
                           Text="左侧是规范和报告使用的逻辑测点，右侧选择实际接线的巡检仪接口。同一类测点不能重复使用同一个物理接口。"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,16">
                <Border Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="7" Padding="14">
                    <StackPanel>
                        <TextBlock Text="温度测点" FontSize="17" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <DataGrid x:Name="TemperatureMappingGrid" Margin="0,10,0,0" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                  RowHeaderWidth="0" GridLinesVisibility="Horizontal" MinHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="逻辑测点" Binding="{Binding LogicalPointLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridComboBoxColumn x:Name="TemperaturePhysicalColumn" Header="巡检仪物理接口" SelectedItemBinding="{Binding PhysicalChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border x:Name="HumidityMappingPanel" Margin="0,14,0,0" Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="7" Padding="14">
                    <StackPanel>
                        <TextBlock Text="湿度测点" FontSize="17" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Margin="0,5,0,0" Foreground="#64748B" TextWrapping="Wrap"
                                   Text="H1～H9 对应设备物理使能通道25～33；界面仍按湿度接口 H1～H9 显示。"/>
                        <DataGrid x:Name="HumidityMappingGrid" Margin="0,10,0,0" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                  RowHeaderWidth="0" GridLinesVisibility="Horizontal" MinHeight="130">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="逻辑测点" Binding="{Binding LogicalPointLabel}" IsReadOnly="True" Width="*"/>
                                <DataGridComboBoxColumn x:Name="HumidityPhysicalColumn" Header="巡检仪物理接口" SelectedItemBinding="{Binding PhysicalChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#D8E0EA" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#64748B" Text="保存后随任务写入本地文件，并用于实时矩阵、正式采样和报告。"/>
                <Button DockPanel.Dock="Right" Width="120" Margin="10,0,0,0" Content="保存绑定" Click="SaveButton_Click" Padding="16,8" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                <Button DockPanel.Dock="Right" Width="90" Content="取消" IsCancel="True" Padding="16,8"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
