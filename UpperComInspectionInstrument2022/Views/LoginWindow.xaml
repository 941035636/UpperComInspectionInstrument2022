<Window x:Class="UpperComInspectionInstrument2022.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 - 温湿度巡检仪校准系统"
        Width="860" Height="570"
        MinWidth="860" MinHeight="570"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Window.Resources>
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="InputPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#0F172A">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" Height="362" >
                    <!--<Border Width="54" Height="54" CornerRadius="12" Background="#2563EB" HorizontalAlignment="Left">-->
                        <!--<TextBlock Text="校" Foreground="White" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>-->
                    <!--</Border>-->
                    <TextBlock Text="温湿度巡检仪校准系统" Foreground="White" FontSize="25" FontWeight="Bold" Margin="0,0,0,0" Height="43"/>
                    <!--<TextBlock Text="标准器数据采集、校准计算与报告归档"
                               Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"/>-->
                    <!--<Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="本地离线账户" Foreground="#93C5FD" FontWeight="SemiBold"/>
                            <TextBlock Text="账户仅保存在当前 Windows 用户目录，密码不会以明文保存。"
                                       Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>-->
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Version 1.0.0" Foreground="#64748B" FontSize="11"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="62,42">
            <Grid x:Name="LoginPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="登录系统" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="请输入本机账户后进入校准工作台" FontSize="13" Foreground="#64748B" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="用户名" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox x:Name="LoginUserNameTextBox" Style="{StaticResource InputTextBox}"
                             AutomationProperties.Name="登录用户名"/>
                    <TextBlock Text="密码" Foreground="#334155" FontWeight="SemiBold" Margin="0,18,0,7"/>

                    <PasswordBox x:Name="LoginPasswordBox" Style="{StaticResource InputPasswordBox}"
                                 AutomationProperties.Name="登录密码"/>
                    <DockPanel Margin="0,4,0,0" LastChildFill="False">
                        <CheckBox x:Name="RememberPasswordCheckBox" Content="记住密码"
                                  VerticalAlignment="Center" Foreground="#475569"
                                  AutomationProperties.Name="记住密码"/>
                        <Button x:Name="ForgotPasswordButton" Content="忘记密码？重新注册"
                                DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                Click="ForgotPasswordButton_Click"/>
                    </DockPanel>
                    <TextBlock x:Name="LoginMessageTextBlock" Foreground="#B91C1C" FontSize="12"
                               MinHeight="20" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <Button Content="登录" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0"
                            IsDefault="True" Click="LoginButton_Click"/>
                    <!--<TextBlock Text="首次运行且没有账户时，系统会自动进入账户创建。"
                               Foreground="#64748B" FontSize="11" TextAlignment="Center" Margin="0,16,0,0"/>-->
                </StackPanel>
                <Button Grid.Row="2" Content="退出程序" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right" Foreground="#64748B" IsCancel="True"/>
            </Grid>

            <Grid x:Name="RegisterPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="注册本地账户" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock x:Name="RegisterInfoTextBlock" Text="创建后即可在本机登录"
                               FontSize="13" Foreground="#64748B" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="用户名" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <TextBox x:Name="RegisterUserNameTextBox" Style="{StaticResource InputTextBox}"
                                     AutomationProperties.Name="注册用户名"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="显示名称（可选）" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <TextBox x:Name="RegisterDisplayNameTextBox" Style="{StaticResource InputTextBox}"
                                     AutomationProperties.Name="显示名称"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="密码" Foreground="#334155" FontWeight="SemiBold" Margin="0,16,0,7"/>
                    <PasswordBox x:Name="RegisterPasswordBox" Style="{StaticResource InputPasswordBox}"
                                 AutomationProperties.Name="注册密码"/>
                    <TextBlock Text="确认密码" Foreground="#334155" FontWeight="SemiBold" Margin="0,16,0,7"/>
                    <PasswordBox x:Name="RegisterConfirmPasswordBox" Style="{StaticResource InputPasswordBox}"
                                 AutomationProperties.Name="确认密码"/>
                    <TextBlock Text="密码长度至少 8 位，并同时包含字母和数字。"
                               Foreground="#64748B" FontSize="11" Margin="0,6,0,0"/>
                    <TextBlock x:Name="RegisterMessageTextBlock" Foreground="#B91C1C" FontSize="12"
                               MinHeight="20" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <Button x:Name="RegisterButton" Content="创建账户" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0"
                            IsDefault="True" Click="RegisterButton_Click"/>
                    <Button x:Name="BackToLoginButton" Content="返回登录" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"
                            Click="BackToLoginButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
