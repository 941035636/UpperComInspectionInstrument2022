<Page x:Class="UpperComInspectionInstrument2022.Views.ReportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="报告归档">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="记录与报告归档" FontSize="30" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="报告必须基于已完成的校准采样和计算结果生成。" Margin="0,8,0,0" Foreground="#6B7280"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,22,0,16" Padding="20" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="当前任务" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="ReportStatusTextBlock" Text="尚未完成校准采样，暂不能生成报告。" Margin="0,12,0,0" Foreground="#B45309" FontSize="15"/>
                <TextBlock Text="完成采样后，系统将在这里生成包含规范依据、设备信息、环境条件、测点原始记录、计算结果和不确定度的归档文件。" Margin="0,8,0,0" Foreground="#6B7280" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Padding="20" Background="#F9FAFB" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="输出内容" FontSize="18" FontWeight="SemiBold"/>
                <CheckBox Content="校准原始记录表" IsChecked="True" Margin="0,16,0,0"/>
                <CheckBox Content="校准结果汇总" IsChecked="True" Margin="0,10,0,0"/>
                <CheckBox Content="校准证书" IsChecked="True" Margin="0,10,0,0"/>
                <CheckBox Content="测量不确定度评定" IsChecked="True" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="返回结果" Click="BackResultButton_Click" Padding="20,9" Margin="0,0,10,0"/>
            <Button x:Name="GenerateReportButton" Content="生成报告" Click="GenerateReportButton_Click" Padding="20,9" Background="#2563EB" Foreground="White" BorderThickness="0" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Page>
