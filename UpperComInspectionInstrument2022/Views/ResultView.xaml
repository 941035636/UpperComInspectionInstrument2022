<Page x:Class="UpperComInspectionInstrument2022.Views.ResultView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="结果与报告">
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" Padding="28,20" BorderBrush="#D8E0EA" BorderThickness="0,0,0,1">
            <StackPanel><TextBlock Text="结果与报告" FontSize="27" FontWeight="Bold" Foreground="#0F172A"/><TextBlock Text="步骤 3/3 · 查看结果判定并生成当前任务记录与报告" Margin="0,6,0,0" Foreground="#64748B"/></StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="28,18,28,0" Padding="16" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="7">
            <StackPanel><TextBlock x:Name="ResultStatusTextBlock" Text="当前任务尚未完成采样" FontSize="17" FontWeight="SemiBold" Foreground="#9A3412"/><TextBlock x:Name="ResultHintTextBlock" Text="请先返回校准工作台完成稳定观察和计划采样。" Margin="0,6,0,0" Foreground="#9A3412" TextWrapping="Wrap"/></StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="28,14,28,0" Padding="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="任务依据" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="TaskReferenceTextBlock" Text="尚未建立任务" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,5,12,0" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="现场环境" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="EnvironmentTextBlock" Text="-" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,5,12,0"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="标准器快照" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="StandardSnapshotTextBlock" Text="-" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="3" Margin="28,14,28,0" Rows="2" Columns="3">
            <Border x:Name="Metric1Card" Margin="0,0,7,7" Padding="18" Background="White" CornerRadius="7" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock x:Name="Metric1Label" Text="结果项目" Foreground="#64748B"/><TextBlock x:Name="Metric1Value" Text="--" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="Metric1Hint" Text="按规范公式计算" Foreground="#94A3B8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border x:Name="Metric2Card" Margin="7,0,7,7" Padding="18" Background="White" CornerRadius="7" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock x:Name="Metric2Label" Text="结果项目" Foreground="#64748B"/><TextBlock x:Name="Metric2Value" Text="--" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="Metric2Hint" Text="按规范公式计算" Foreground="#94A3B8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border x:Name="Metric3Card" Margin="7,0,0,7" Padding="18" Background="White" CornerRadius="7" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock x:Name="Metric3Label" Text="结果项目" Foreground="#64748B"/><TextBlock x:Name="Metric3Value" Text="--" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="Metric3Hint" Text="按规范公式计算" Foreground="#94A3B8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border x:Name="Metric4Card" Margin="0,7,7,0" Padding="18" Background="White" CornerRadius="7" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock x:Name="Metric4Label" Text="结果项目" Foreground="#64748B"/><TextBlock x:Name="Metric4Value" Text="--" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="Metric4Hint" Text="按规范公式计算" Foreground="#94A3B8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border x:Name="Metric5Card" Margin="7,7,7,0" Padding="18" Background="White" CornerRadius="7" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock x:Name="Metric5Label" Text="测量不确定度" Foreground="#64748B"/><TextBlock x:Name="Metric5Value" Text="待评定" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="Metric5Hint" Text="不能仅用标准器证书 U 代替完整评定" Foreground="#94A3B8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border x:Name="Metric6Card" Margin="7,7,0,0" Padding="18" Background="White" CornerRadius="7" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock x:Name="Metric6Label" Text="正式样本" Foreground="#64748B"/><TextBlock x:Name="Metric6Value" Text="--" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="Metric6Hint" Text="与实时趋势数据分离" Foreground="#94A3B8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </UniformGrid>

        <Border Grid.Row="4" Background="White" BorderBrush="#D8E0EA" BorderThickness="0,1,0,0" Padding="28,12" Margin="0,18,0,0">
            <DockPanel><TextBlock Text="结果计算模块接入前，本页只展示任务依据和流程状态，不生成虚假判定。" Foreground="#64748B" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="返回校准工作台" Click="BackCalibrationButton_Click" Padding="20,9" Margin="0,0,10,0"/><Button x:Name="OpenReportButton" Content="查看报告准备状态" Click="OpenReportButton_Click" Padding="20,9" Background="#2563EB" Foreground="White" BorderThickness="0"/></StackPanel></DockPanel>
        </Border>
    </Grid>
</Page>
