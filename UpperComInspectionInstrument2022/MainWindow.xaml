<Window x:Class="UpperComInspectionInstrument2022.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工业设备校准系统"
        Width="1400" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">
    <Window.Resources>
        <Style TargetType="Button" x:Key="NavigationButton">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="温湿度校准系统" Foreground="White" FontSize="23" FontWeight="Bold"/>
                    <Border Width="1" Height="24" Background="#475569" Margin="16,0"/>
                    <TextBlock Text="温湿度巡检仪数据采集与校准" Foreground="#CBD5E1" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#0F172A" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,7,0"/><TextBlock Text="系统运行中" Foreground="#E2E8F0" FontSize="12"/></StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="198"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0F172A">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="20,22,20,12">
                        <TextBlock Text="功能导航" Foreground="White" FontSize="17" FontWeight="Bold"/>

                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="主要功能" Foreground="#64748B" FontSize="11" Margin="20,12,20,3"/>
                        <Button x:Name="CalibrationTaskButton" Content="校准作业" Click="CalibrationTaskButton_Click" Style="{StaticResource NavigationButton}"/>
                        <Button x:Name="HistoryButton" Content="历史记录" Click="HistoryButton_Click" Style="{StaticResource NavigationButton}"/>
                        <TextBlock Text="系统" Foreground="#64748B" FontSize="11" Margin="20,16,20,3"/>
                        <Button x:Name="SettingsButton" Content="系统设置" Click="SettingsButton_Click" Style="{StaticResource NavigationButton}"/>

                        <Button x:Name="HomeButton" Visibility="Collapsed" Click="HomeButton_Click"/>
                        <Button x:Name="RealTimeMeasurementButton" Visibility="Collapsed" Click="RealTimeMeasurementButton_Click"/>
                        <Button x:Name="CalibrationResultButton" Visibility="Collapsed" Click="CalibrationResultButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="20,10,20,18">
                        <TextBlock Text="当前接入" Foreground="#64748B" FontSize="11"/>
                        <TextBlock Text="温湿度巡检仪" Foreground="#CBD5E1" FontSize="12" Margin="0,5,0,0"/>
                        <TextBlock Text="Modbus RTU · RS232" Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="#F1F5F9">
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="BottomStatusTextBlock" Text="状态：系统就绪" VerticalAlignment="Center" Foreground="#475569" FontSize="11"/><TextBlock Grid.Column="1" Text="Version 1.0" VerticalAlignment="Center" Foreground="#64748B" FontSize="11"/></Grid>
        </Border>
    </Grid>
</Window>
